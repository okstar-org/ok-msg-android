<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/activity_video_conference_history_item_image"
            android:layout_width="120dp"
            android:layout_height="80dp"
            android:padding="18dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_workbench_pld"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/activity_video_conference_history_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/activity_video_conference_history_item_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/activity_video_conference_history_item_image"
            tools:text="应用名称"/>

        <TextView
            android:id="@+id/activity_video_conference_history_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#949494"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/activity_video_conference_history_item_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/activity_video_conference_history_item_image"
            tools:text="01月09日 11:09"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>