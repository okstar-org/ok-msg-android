<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/activity_video_conference_panel_item_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:padding="18dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_workbench_pld"
            app:layout_constraintBottom_toTopOf="@id/activity_video_conference_panel_item_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/activity_video_conference_panel_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="@id/activity_video_conference_panel_item_image"
            app:layout_constraintRight_toRightOf="@id/activity_video_conference_panel_item_image"
            app:layout_constraintTop_toBottomOf="@id/activity_video_conference_panel_item_image"
            tools:text="应用名称"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>